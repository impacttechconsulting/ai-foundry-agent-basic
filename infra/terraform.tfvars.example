# Example Terraform variables file
# Copy this to terraform.tfvars and update with your values

resource_group_name     = "my-ai-foundry-rg"
location               = "East US"
app_service_plan_name  = "my-ai-foundry-plan"
app_service_name       = "my-ai-foundry-app"
app_service_sku        = "B1"
ai_project_endpoint    = "https://my-ai-project.azure.com/api/projects/my-project"
ai_agent_id            = "my-agent-id"
key_vault_name         = "my-ai-foundry-kv"
application_insights_name = "my-ai-foundry-ai"